{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure debug",
            "type": "shell",
            "command": "cmake --preset debug"
        },
        {
            "label": "build debug",
            "type": "shell",
            "command": "cmake --build build/debug",
            "dependsOn": "configure debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}